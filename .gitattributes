# Normalize line endings. Without this, editing on Windows silently rewrites
# every line of a file to CRLF, turning a 50-line change into a 4,000-line diff
# and making review impossible.
* text=auto eol=lf

# Never touch binaries.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.woff binary
*.woff2 binary
